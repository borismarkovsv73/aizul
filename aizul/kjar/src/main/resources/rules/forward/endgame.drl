package rules.forward

import com.ftn.sbnz.model.models.Move;
import com.ftn.sbnz.model.models.Board;
import com.ftn.sbnz.model.models.Tile;
import com.ftn.sbnz.model.models.Player;
import com.ftn.sbnz.model.models.GameState;
import com.ftn.sbnz.model.utils.BoardUtils;

rule "Strategic wall-row completion"
    when
        $m : Move()
        $gameState : GameState($players : players)
        $currentPlayer : Player($board : board) from $players
        eval($currentPlayer == $players.get(0))
        eval(BoardUtils.willCompleteWallRowAfterMove($board, $m))
    then
        if (BoardUtils.isProjectedAheadAfterMove($currentPlayer, $players, $m)) {
            $m.setScore($m.getScore() + 15);
            $m.addAppliedRule(true, "After wall tiling, this move completes a wall row and ends the game while you are projected to lead.");
        } else {
            $m.setScore($m.getScore() - 15);
            $m.addAppliedRule(false, "After wall tiling, this move completes a wall row and ends the game while you are not projected to lead.");
        }
end
