package rules.forward

import com.ftn.sbnz.model.models.Move;
import com.ftn.sbnz.model.models.Board;
import com.ftn.sbnz.model.models.Player;
import com.ftn.sbnz.model.models.GameState;
import com.ftn.sbnz.model.utils.BoardUtils;

rule "Block enemy pattern-line completion"
    when
        $m : Move()
        $gameState : GameState($players : players)
        $enemy : Player($enemyBoard : board) from $players
        eval($enemy != $players.get(0))
        eval(BoardUtils.canBlockEnemyPatternLineCompletion($enemyBoard, $m))
    then
        $m.setScore($m.getScore() + 8);
        $m.addAppliedRule(true, "You take enough of a color to deny an enemy's started pattern line.");
end
