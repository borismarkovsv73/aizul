package rules.backward

import com.ftn.sbnz.model.models.Move;
import com.ftn.sbnz.model.models.Board;
import com.ftn.sbnz.model.utils.BoardUtils;

query "recursiveColorDepthChain"( Move move, Board board, Integer currentDepth )
  eval(BoardUtils.willAdvanceColorSetAtCount(board, move, currentDepth))
  or
  ( eval(currentDepth < 4) and recursiveColorDepthChain( move, board, currentDepth + 1; ) )
end

rule "Find Recursive Color Answer"
    salience 85
    no-loop true
    when
        $move : Move()
        $board : Board()
        recursiveColorDepthChain( $move, $board, 1; )
        not String(this == "COLOR_PROCESSED_" + $move.hashCode())
    then
        String processed = "COLOR_PROCESSED_" + $move.hashCode();
        insert(processed);

        int bonusPoints = 0;
        int depth = 0;
        if (BoardUtils.willAdvanceColorSetAtCount($board, $move, 4)) {
            bonusPoints = 25;
            depth = 1;
        } else if (BoardUtils.willAdvanceColorSetAtCount($board, $move, 3)) {
            bonusPoints = 20;
            depth = 2;
        } else if (BoardUtils.willAdvanceColorSetAtCount($board, $move, 2)) {
            bonusPoints = 15;
            depth = 3;
        } else if (BoardUtils.willAdvanceColorSetAtCount($board, $move, 1)) {
            bonusPoints = 10;
            depth = 4;
        }
        
        int newScore = $move.getScore() + bonusPoints;
        $move.setScore(newScore);
        
        String message = "Including this wall-tiling phase, this color set is " + depth + " placements from completion.";
        $move.addAppliedRule(true, message);
end
