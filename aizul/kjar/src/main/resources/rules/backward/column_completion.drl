package rules.backward

import com.ftn.sbnz.model.models.Move;
import com.ftn.sbnz.model.models.Board;
import com.ftn.sbnz.model.utils.BoardUtils;

query "recursiveColumnDepthChain"( Move move, Board board, Integer currentDepth )
  eval(BoardUtils.willAdvanceWallColumnAtDepth(board, move, currentDepth))
  or
  ( eval(currentDepth < 3) and recursiveColumnDepthChain( move, board, currentDepth + 1; ) )
end

rule "Find Recursive Column Answer"
    salience 90
    no-loop true
    when
        $move : Move()
        $board : Board()
        recursiveColumnDepthChain( $move, $board, 1; )
        not String(this == "COL_PROCESSED_" + $move.hashCode())
    then
        String processed = "COL_PROCESSED_" + $move.hashCode();
        insert(processed);
        
        int bonusPoints = 0;
        int depth = 0;
        if (BoardUtils.willAdvanceWallColumnAtDepth($board, $move, 1)) {
            bonusPoints = 25;
            depth = 1;
        } else if (BoardUtils.willAdvanceWallColumnAtDepth($board, $move, 2)) {
            bonusPoints = 20;
            depth = 2;
        } else if (BoardUtils.willAdvanceWallColumnAtDepth($board, $move, 3)) {
            bonusPoints = 15;
            depth = 3;
        }
        
        int newScore = $move.getScore() + bonusPoints;
        $move.setScore(newScore);
        
        int wallColumn = BoardUtils.getWallColumnForColor($move.getTargetRow(), BoardUtils.getMoveColor($move));
        String message = "Including this wall-tiling phase, wall column " + (wallColumn + 1) + " is " + depth + " placements from completion.";
        $move.addAppliedRule(true, message);
end
