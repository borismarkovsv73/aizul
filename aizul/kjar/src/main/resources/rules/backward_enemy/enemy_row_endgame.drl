package rules.backward_enemy

import com.ftn.sbnz.model.models.Move;
import com.ftn.sbnz.model.models.Board;
import com.ftn.sbnz.model.models.Player;
import com.ftn.sbnz.model.models.GameState;
import com.ftn.sbnz.model.utils.BoardUtils;

query "recursiveEnemyRowTileChain"( Move move, Board enemyBoard, Integer tilesOnRow )
  eval(BoardUtils.canEnemyAdvanceWallRow(enemyBoard, move, tilesOnRow))
  or
  ( eval(tilesOnRow < 4) and recursiveEnemyRowTileChain( move, enemyBoard, tilesOnRow + 1; ) )
end

rule "Evaluate blocking an enemy wall-row finish"
    salience 95
    no-loop true
    when
        $move : Move()
        $gameState : GameState($players : players)
        $currentPlayer : Player() from $players
        eval($currentPlayer == $players.get(0))
        $enemyPlayer : Player($enemyBoard : board) from $players
        eval($enemyPlayer != $currentPlayer)
        recursiveEnemyRowTileChain( $move, $enemyBoard, 3; )
        not String(this == "ENEMY_ENDGAME_PROCESSED_" + $move.hashCode() + "_" + $enemyPlayer.getId())
    then
        String processed = "ENEMY_ENDGAME_PROCESSED_" + $move.hashCode() + "_" + $enemyPlayer.getId();
        insert(processed);

        int adjustment = 0;
        int tilesOnRow = 0;

        if (BoardUtils.canEnemyAdvanceWallRow($enemyBoard, $move, 4)) {
            adjustment = 20;
            tilesOnRow = 4;
        } else if (BoardUtils.canEnemyAdvanceWallRow($enemyBoard, $move, 3)) {
            adjustment = 3;
            tilesOnRow = 3;
        }

        if (BoardUtils.isProjectedAheadIfEnemyTakesMove($currentPlayer, $enemyPlayer, $players, $move)) {
            $move.setScore($move.getScore() - adjustment);
            $move.addAppliedRule(false, "Player " + $enemyPlayer.getId() + " can advance a wall row with this color; while you are projected to lead, blocking that route delays a favorable endgame.");
        } else {
            $move.setScore($move.getScore() + adjustment);
            $move.addAppliedRule(true, "Player " + $enemyPlayer.getId() + " can advance a wall row with this color; while you are not projected to lead, blocking that route is valuable.");
        }
end
