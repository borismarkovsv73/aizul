package rules.backward_enemy

import com.ftn.sbnz.model.models.Move;
import com.ftn.sbnz.model.models.Board;
import com.ftn.sbnz.model.models.Player;
import com.ftn.sbnz.model.models.GameState;
import com.ftn.sbnz.model.utils.BoardUtils;

query "recursiveEnemyColorTileChain"( Move move, Board enemyBoard, Integer tilesOfColor )
  eval(BoardUtils.canEnemyAdvanceColorSet(enemyBoard, move, tilesOfColor))
  or
  ( eval(tilesOfColor < 4) and recursiveEnemyColorTileChain( move, enemyBoard, tilesOfColor + 1; ) )
end

rule "Block Enemy Color Progress"
    salience 85
    no-loop true
    when
        $move : Move()
        $gameState : GameState($players : players)
        $currentPlayer : Player() from $players
        eval($currentPlayer == $players.get(0))
        $enemyPlayer : Player($enemyBoard : board) from $players
        eval($enemyPlayer != $currentPlayer)
        recursiveEnemyColorTileChain( $move, $enemyBoard, 2; )
        not String(this == "ENEMY_COLOR_PROCESSED_" + $move.hashCode() + "_" + $enemyPlayer.getId())
    then
        String processed = "ENEMY_COLOR_PROCESSED_" + $move.hashCode() + "_" + $enemyPlayer.getId();
        insert(processed);

        int bonusPoints = 0;
        int tilesOfColor = 0;
        if (BoardUtils.canEnemyAdvanceColorSet($enemyBoard, $move, 4)) {
            bonusPoints = 15;
            tilesOfColor = 4;
        } else if (BoardUtils.canEnemyAdvanceColorSet($enemyBoard, $move, 3)) {
            bonusPoints = 10;
            tilesOfColor = 3;
        } else if (BoardUtils.canEnemyAdvanceColorSet($enemyBoard, $move, 2)) {
            bonusPoints = 5;
            tilesOfColor = 2;
        }

        int newScore = $move.getScore() + bonusPoints;
        $move.setScore(newScore);

        String message = "You block player " + $enemyPlayer.getId() + " from advancing a " + BoardUtils.getMoveColor($move) + " wall-color set (currently " + tilesOfColor + "/5).";
        $move.addAppliedRule(true, message);
end
