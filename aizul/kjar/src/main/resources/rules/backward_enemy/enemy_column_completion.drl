package rules.backward_enemy

import com.ftn.sbnz.model.models.Move;
import com.ftn.sbnz.model.models.Board;
import com.ftn.sbnz.model.models.Player;
import com.ftn.sbnz.model.models.GameState;
import com.ftn.sbnz.model.utils.BoardUtils;

query "recursiveEnemyColumnTileChain"( Move move, Board enemyBoard, Integer tilesOnColumn )
  eval(BoardUtils.canEnemyAdvanceWallColumn(enemyBoard, move, tilesOnColumn))
  or
  ( eval(tilesOnColumn < 4) and recursiveEnemyColumnTileChain( move, enemyBoard, tilesOnColumn + 1; ) )
end

rule "Block Enemy Column Progress"
    salience 85
    no-loop true
    when
        $move : Move()
        $gameState : GameState($players : players)
        $currentPlayer : Player() from $players
        eval($currentPlayer == $players.get(0))
        $enemyPlayer : Player($enemyBoard : board) from $players
        eval($enemyPlayer != $currentPlayer)
        recursiveEnemyColumnTileChain( $move, $enemyBoard, 2; )
        not String(this == "ENEMY_COLUMN_PROCESSED_" + $move.hashCode() + "_" + $enemyPlayer.getId())
    then
        String processed = "ENEMY_COLUMN_PROCESSED_" + $move.hashCode() + "_" + $enemyPlayer.getId();
        insert(processed);

        int bonusPoints = 0;
        int tilesOnColumn = 0;
        if (BoardUtils.canEnemyAdvanceWallColumn($enemyBoard, $move, 4)) {
            bonusPoints = 15;
            tilesOnColumn = 4;
        } else if (BoardUtils.canEnemyAdvanceWallColumn($enemyBoard, $move, 3)) {
            bonusPoints = 10;
            tilesOnColumn = 3;
        } else if (BoardUtils.canEnemyAdvanceWallColumn($enemyBoard, $move, 2)) {
            bonusPoints = 5;
            tilesOnColumn = 2;
        }

        int newScore = $move.getScore() + bonusPoints;
        $move.setScore(newScore);

        String message = "You block player " + $enemyPlayer.getId() + " from advancing a wall column that currently has " + tilesOnColumn + "/5 tiles.";
        $move.addAppliedRule(true, message);
end
